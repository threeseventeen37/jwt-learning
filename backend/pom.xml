<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
<!--    pom 模型版本-->
    <modelVersion>4.0.0</modelVersion>

<!--    父项目配置-->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
    </parent>

<!--    项目基础坐标-->
<!--    组织,域名反写-->
    <groupId>com.javasm.qingqing</groupId>
<!--    当前 maven 项目标识-->
    <artifactId>jwt-learning-backend</artifactId>
<!--    当前项目的版本-->
    <version>1.0-SNAPSHOT</version>
<!--    项目说明-->
    <description>根项目</description>
<!--    打包类型-->
    <packaging>pom</packaging>

<!--    子模块聚合-->
    <modules>
<!--        web模块-->
        <module>auth-api</module>
<!--        公共基础模块-->
        <module>auth-common-core</module>
<!--        公共数据模块-->
        <module>auth-common-db</module>
    </modules>

<!--    全局属性-->
    <properties>
<!--        开发版本-->
        <maven.compiler.source>21</maven.compiler.source>
<!--        编译版本-->
        <maven.compiler.target>21</maven.compiler.target>
<!--        默认编码-->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
<!--        第三方依赖版本统一管理-->
        <jjwt.version>0.12.6</jjwt.version>
    </properties>

<!--    依赖版本统一管理-->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.javasm.qingqing</groupId>
                <artifactId>auth-api</artifactId>
                <version>1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>com.javasm.qingqing</groupId>
                <artifactId>auth-common-core</artifactId>
                <version>1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>com.javasm.qingqing</groupId>
                <artifactId>auth-common-db</artifactId>
                <version>1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

<!--    所有子模块共同需要的实际依赖-->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
    </dependencies>

</project>